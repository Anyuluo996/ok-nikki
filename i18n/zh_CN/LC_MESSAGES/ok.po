msgid "Daily Quest"
msgstr "一键日常"

msgid "Open the in-game menu, claim mail attachments and the free shop pack."
msgstr "打开游戏菜单, 领取邮件附件和商城免费礼包。"

msgid "Claim Mail"
msgstr "领取邮件"

msgid "Open the mailbox and claim all attachments."
msgstr "打开邮箱并领取全部附件。"

msgid "Claim Shop Free Pack"
msgstr "领取商城免费礼包"

msgid "Open the shop and claim the free daily pack."
msgstr "打开商城并领取每日免费礼包。"

msgid "Mail"
msgstr "邮件"

msgid "Shop"
msgstr "商城"

msgid "Claimed"
msgstr "已领取"

msgid "Whim Calendar"
msgstr "奇想日历"

msgid "Open the Whim Calendar, claim available rewards and check daily quests."
msgstr "打开奇想日历, 领取可领奖励并查看每日任务。"

msgid "Claim Calendar Rewards"
msgstr "领取日历奖励"

msgid "Open Zhaoxi Quests"
msgstr "查看朝夕心愿"

msgid "Open the Zhaoxi daily quest page to check progress."
msgstr "打开朝夕心愿每日任务页查看进度。"

msgid "Calendar"
msgstr "日历"

msgid "Zhaoxi Quests"
msgstr "朝夕心愿"

msgid "Meiyali Dig"
msgstr "美鸭梨挖掘"

msgid "Claim finished Meiyali dig rewards and start digging again."
msgstr "领取美鸭梨挖掘成品并继续挖掘。"

msgid "Dig Again After Harvest"
msgstr "收获后继续挖掘"

msgid "Start the same dig again right after harvesting."
msgstr "收获后用相同物资立即开始下一轮挖掘。"

msgid "Dig"
msgstr "挖掘"

msgid "In Progress"
msgstr "挖掘中"

msgid "Need Manual Setup"
msgstr "需手动设置"

msgid "Harvested & Restarted"
msgstr "已收获并续挖"

msgid "Harvested"
msgstr "已收获"

msgid "Realm Challenge"
msgstr "幻境挑战"

msgid "Spend energy via quick challenge in the realm (weekly boss)."
msgstr "在幻境挑战中快速挑战消耗活跃能量。"

msgid "Challenge Count"
msgstr "挑战次数"

msgid "How many quick challenges to run (each consumes energy)."
msgstr "快速挑战的次数(每次消耗体力)。"

msgid "Realm Level"
msgstr "挑战关卡"

msgid "Which weekly boss level to quick challenge."
msgstr "快速挑战哪个周本关卡。"

msgid "Realm"
msgstr "幻境"

msgid "Challenged"
msgstr "已挑战"

msgid "Weekly Realm"
msgstr "每周幻境"

msgid "Confirmed"
msgstr "已确认"

msgid "Weekly Done"
msgstr "本周已领"
